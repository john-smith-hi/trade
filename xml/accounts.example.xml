<?xml version="1.0" encoding="UTF-8"?>
<!--
    MẪU file cấu hình tài khoản MT5 (không chứa dữ liệu thật, an toàn để commit lên git).
    Copy file này thành "accounts.xml" (cùng thư mục với mt5.py) rồi điền thông tin thật vào.
    Có thể chỉnh sửa trực tiếp bằng tay, hoặc dùng tab "Quản lý tài khoản" trong gui_mt5.py.

    - name    : tên account dùng trong tham số account hoặc trên giao diện (không trùng nhau).
    - login   : số tài khoản MT5.
    - password: mật khẩu đăng nhập MT5.
    - server  : tên server broker.
    - path    : đường dẫn terminal64.exe tương ứng broker (để trống nếu dùng terminal mặc định).
    - suffix  : hậu tố symbol riêng của broker (Exness = "m", FTMO = "").
    - multi   : hệ số nhân lot khi copy lệnh sang tài khoản này (bỏ trống/1.0 nếu không cần).
-->
<accounts>
    <account>
        <name>demo</name>
        <login>0</login>
        <password>CHANGE_ME</password>
        <server>CHANGE_ME</server>
        <path></path>
        <suffix></suffix>
        <multi>1.0</multi>
    </account>
</accounts>
